{
  "name": "open-graph-scraper",
  "description": "A Node.js library for extracting Open Graph, Twitter Card, JSON-LD, and other metadata from web pages",
  "version": "6.13.0",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./types": "./types/lib/types.d.ts"
  },
  "scripts": {
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --outDir dist/cjs/",
    "build:declaration": "tsc --project tsconfig.declaration.json --module node16 --moduleResolution node16",
    "build:esm": "tsc --project tsconfig.build.json --module node16 --moduleResolution node16 --outDir dist/esm/",
    "build": "rm -rf dist/ && npm run build:cjs && npm run build:esm",
    "ci": "npm run eslint && npm run build && npm run build:declaration && npm run test",
    "eslint:fix": "eslint . --ext .js,.ts --fix",
    "eslint": "eslint . --ext .js,.ts",
    "mocha:int": "mocha --require ts-node/register/transpile-only --recursive \"./tests/integration/**/*.spec.ts\" --timeout 10000",
    "mocha:unit": "nyc --reporter=html --reporter=text --exclude=tests/ mocha --require ts-node/register/transpile-only --recursive \"./tests/unit/**/*.spec.ts\"",
    "prepare": "npm run snyk-protect && npm run build",
    "snyk-protect": "snyk-protect",
    "test": "npm run mocha:unit && npm run mocha:int"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": {
    "name": "Josh Shemas",
    "email": "jjs90jjs@gmail.com",
    "url": "https://github.com/jshemas"
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "cheerio": "^1.2.0",
    "iconv-lite": "^0.7.3",
    "undici": "^7.30.2"
  },
  "files": [
    "/dist",
    "/types",
    "index.ts",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@snyk/protect": "^1.1309.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "chai": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-promise": "^7.2.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jshemas/openGraphScraper.git",
    "web": "http://github.com/jshemas/openGraphScraper"
  },
  "keywords": [
    "app-links",
    "dublin-core",
    "html",
    "html metadata",
    "json ld",
    "link preview",
    "meta tags",
    "metadata",
    "node",
    "nodejs",
    "og",
    "ogp",
    "ogs",
    "open graph scraper",
    "open graph",
    "opengraph",
    "openGraphScraper",
    "rich previews",
    "scraper",
    "social media",
    "social metadata",
    "structured data",
    "twitter card",
    "twitter",
    "web scraping",
    "website preview"
  ],
  "snyk": true
}
